Upstream Turnip fixes for stale push constants and descriptors (smear candidates), picked onto our Mesa pin:
  ebf49bf11 tu: Fix bindless descriptor invalidate sequence
  b231b60fe tu: Don't bail after the first instr when gathering push const range
  a3cc401b6 tu/a6xx: Invalidate shared consts before disabling them

diff --git a/src/freedreno/vulkan/tu_cmd_buffer.cc b/src/freedreno/vulkan/tu_cmd_buffer.cc
index 9bd9fbc3d..5939a238b 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.cc
+++ b/src/freedreno/vulkan/tu_cmd_buffer.cc
@@ -383,10 +383,14 @@ tu6_emit_flushes(struct tu_cmd_buffer *cmd_buffer,
    if (flushes & TU_CMD_FLAG_CACHE_INVALIDATE)
       tu_emit_event_write<CHIP>(cmd_buffer, cs, FD_CACHE_INVALIDATE);
    if (flushes & TU_CMD_FLAG_BINDLESS_DESCRIPTOR_INVALIDATE) {
-      tu_cs_emit_regs(cs, SP_UPDATE_CNTL(CHIP,
-            .cs_bindless = CHIP == A6XX ? 0x1f : 0xff,
-            .gfx_bindless = CHIP == A6XX ? 0x1f : 0xff,
-      ));
+      if (CHIP < A8XX) {
+         tu_cs_emit_regs(cs, SP_UPDATE_CNTL(CHIP,
+               .cs_bindless = CHIP == A6XX ? 0x1f : 0xff,
+               .gfx_bindless = CHIP == A6XX ? 0x1f : 0xff,
+         ));
+      }
+      tu_cs_emit_regs(cs, A6XX_SP_CS_BINDLESS_INVALIDATE(1));
+      tu_cs_emit_regs(cs, A6XX_SP_GFX_BINDLESS_INVALIDATE(1));
    }
    if (CHIP >= A7XX && flushes & TU_CMD_FLAG_BLIT_CACHE_CLEAN)
       /* On A7XX, blit cache flushes are required to ensure blit writes are visible
diff --git a/src/freedreno/vulkan/tu_pipeline.cc b/src/freedreno/vulkan/tu_pipeline.cc
index 8b010ed1a..df9bd366d 100644
--- a/src/freedreno/vulkan/tu_pipeline.cc
+++ b/src/freedreno/vulkan/tu_pipeline.cc
@@ -1353,12 +1353,20 @@ tu6_emit_program_config(struct tu_cs *cs,
 
    bool shared_consts_enable =
       prog->shared_consts.type == IR3_PUSH_CONSTS_SHARED;
-   tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
 
+   /* A6XX: SP_UPDATE_CNTL::GFX_SHARED_CONST only has an effect while HLSQ_SHARED_CONSTS is enabled.
+    * If SP_UPDATE_CNTL is emitted after shared consts are disabled, it _presumably_ doesn't clear
+    * the pending shared consts load of a previous pipeline. If there is an event between the draws,
+    * the second draw executes in the same context as the previous one (an event also flips the
+    * context), and the pending load writes the old shared consts into its const space. So
+    * SP_UPDATE_CNTL must happen before HLSQ_SHARED_CONSTS.
+    */
    crb.add(SP_UPDATE_CNTL(CHIP, .vs_state = true, .hs_state = true,
                           .ds_state = true, .gs_state = true,
                           .fs_state = true, .gfx_uav = true,
-                          .gfx_shared_const = shared_consts_enable));
+                          .gfx_shared_const = CHIP == A6XX));
+
+   tu6_emit_shared_consts_enable<CHIP>(crb, shared_consts_enable);
 
    const struct ir3_shader_variant *vs = variants[MESA_SHADER_VERTEX];
    const struct ir3_shader_variant *hs = variants[MESA_SHADER_TESS_CTRL];
