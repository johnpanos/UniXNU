+/* The device's cache of command-stream BOs (tu_device::cs_bo_cache). At most 32 BOs of each kind and 16 MiB in all are kept; a
+ * stream takes the smallest cached BO that holds what it asks for, so a command buffer that grows past its kept BO reuses one
+ * instead of allocating (an allocation and a CPU mapping, each a kernel call on Darwin). */
+#define TU_CS_BO_CACHE_BYTES (16ull << 20)
+
+static struct tu_bo *
+tu_cs_bo_cache_take(struct tu_device *dev, bool writeable, uint64_t bytes)
+{
+   mtx_lock(&dev->cs_bo_cache_mutex);
+   uint32_t n = dev->cs_bo_cache_count[writeable];
+   struct tu_bo **cache = dev->cs_bo_cache[writeable];
+   int best = -1;
+   for (uint32_t i = 0; i < n; i++) {
+      if (cache[i]->size >= bytes && cache[i]->size <= 8 * bytes &&
+          (best < 0 || cache[i]->size < cache[best]->size))
+         best = i;
+   }
+   struct tu_bo *bo = NULL;
+   if (best >= 0) {
+      bo = cache[best];
+      cache[best] = cache[n - 1];
+      dev->cs_bo_cache_count[writeable] = n - 1;
+      dev->cs_bo_cache_bytes -= bo->size;
+   }
+   mtx_unlock(&dev->cs_bo_cache_mutex);
+   return bo;
+}
+
+static void
+tu_cs_bo_release(struct tu_cs *cs, struct tu_bo *bo, bool writeable)
+{
+   struct tu_device *dev = cs->device;
+   if (cs->recycle && bo->map) {
+      mtx_lock(&dev->cs_bo_cache_mutex);
+      uint32_t n = dev->cs_bo_cache_count[writeable];
+      if (n < ARRAY_SIZE(dev->cs_bo_cache[0]) &&
+          dev->cs_bo_cache_bytes + bo->size <= TU_CS_BO_CACHE_BYTES) {
+         dev->cs_bo_cache[writeable][n] = bo;
+         dev->cs_bo_cache_count[writeable] = n + 1;
+         dev->cs_bo_cache_bytes += bo->size;
+         mtx_unlock(&dev->cs_bo_cache_mutex);
+         return;
+      }
+      mtx_unlock(&dev->cs_bo_cache_mutex);
+   }
+   TU_RMV(resource_destroy, dev, bo);
+   tu_bo_finish(dev, bo);
+}
+
+void
+tu_cs_bo_cache_finish(struct tu_device *dev)
+{
+   for (unsigned w = 0; w < 2; w++) {
+      for (uint32_t i = 0; i < dev->cs_bo_cache_count[w]; i++) {
+         TU_RMV(resource_destroy, dev, dev->cs_bo_cache[w][i]);
+         tu_bo_finish(dev, dev->cs_bo_cache[w][i]);
+      }
+      dev->cs_bo_cache_count[w] = 0;
+   }
+   dev->cs_bo_cache_bytes = 0;
+   mtx_destroy(&dev->cs_bo_cache_mutex);
+}
