+}
+
+/*
+ * libTrustCache: a minimal in-kernel reimplementation that actually holds the modules.
+ *
+ * This board loads the static system trust cache (fajita_ios16_display_defconfig:
+ * CONFIG_XNU_TRUST_CACHE_RUNTIME; the payload's --trust-cache bundle), which HackiOS's kernel
+ * does not. load_static_trust_cache() hands each module to loadModule below and panics if the
+ * first (static) one fails, so loadModule validates the module and links it onto the runtime's
+ * own lists -- exactly as Apple's closed libTrustCache would -- and query walks those lists and
+ * answers truthfully. This is what lets the AppleMobileFileIntegrity IOService stand-in
+ * (iokit/Kernel/IOStartIOKit.cpp) answer launchd_cache_loader's cdhash checks through the
+ * kernel's own query_trust_cache().
+ *
+ * Platform-binary status for ad hoc signed OS binaries is still granted in
+ * mpo_vnode_check_signature above (there is no per-binary signature check here); the trust cache
+ * is consulted only where the system asks "is this exact cdhash trusted?".
+ *
+ * Entries in a v1/v2 module are sorted by cdhash, so each module is binary-searched. v0 modules
+ * (unsorted, bridgeOS-only, never present here) are scanned linearly.
+ */
+
+/* Stride and first-entry offset for a module version; false if the version is unsupported. */
+static bool
+mini_tc_module_layout(uint32_t version, size_t *entryOff, size_t *entrySize, bool *sorted)
+{
+	switch (version) {
+	case 0: *entryOff = sizeof(TrustCacheModule0_t); *entrySize = sizeof(TrustCacheEntry0_t); *sorted = false; return true;
+	case 1: *entryOff = sizeof(TrustCacheModule1_t); *entrySize = sizeof(TrustCacheEntry1_t); *sorted = true; return true;
+	case 2: *entryOff = sizeof(TrustCacheModule2_t); *entrySize = sizeof(TrustCacheEntry2_t); *sorted = true; return true;
+	default: return false;
+	}
+}
+
+static uint32_t
+mini_tc_module_num_entries(const TrustCacheModuleBase_t *base)
+{
+	switch (base->version) {
+	case 0: return ((const TrustCacheModule0_t *)base)->numEntries;
+	case 1: return ((const TrustCacheModule1_t *)base)->numEntries;
+	case 2: return ((const TrustCacheModule2_t *)base)->numEntries;
+	default: return 0;
+	}
+}
+
+/* Find CDHash within a single module; returns the matched entry or NULL. */
+static const void *
+mini_tc_find_in_module(const TrustCacheModuleBase_t *base, const uint8_t CDHash[kTCEntryHashSize])
+{
+	size_t entryOff, entrySize;
+	bool sorted;
+
+	if (base == NULL || !mini_tc_module_layout(base->version, &entryOff, &entrySize, &sorted)) {
+		return NULL;
+	}
+
+	uint32_t n = mini_tc_module_num_entries(base);
+	const uint8_t *entries = (const uint8_t *)base + entryOff;
+
+	if (sorted) {
+		uint32_t lo = 0, hi = n;
+		while (lo < hi) {
+			uint32_t mid = lo + (hi - lo) / 2;
+			const uint8_t *e = entries + (size_t)mid * entrySize;
+			int cmp = memcmp(CDHash, e, kTCEntryHashSize);
+			if (cmp == 0) {
+				return e;
+			} else if (cmp < 0) {
+				hi = mid;
+			} else {
+				lo = mid + 1;
+			}
+		}
+		return NULL;
+	}
+
+	for (uint32_t i = 0; i < n; i++) {
+		const uint8_t *e = entries + (size_t)i * entrySize;
+		if (memcmp(CDHash, e, kTCEntryHashSize) == 0) {
+			return e;
+		}
+	}
+	return NULL;
+}
+
+static TCReturn_t
+mini_tc_loadModule(TrustCacheRuntime_t *runtime, const TCType_t type, TrustCache_t *trustCache,
+    const uintptr_t dataAddr, const size_t dataSize)
+{
+	if (runtime == NULL || trustCache == NULL || dataAddr == 0) {
+		return buildTCRet(kTCComponentLoadModule, kTCReturnInvalidArguments, 0);
+	}
+	if (dataSize < sizeof(TrustCacheModuleBase_t)) {
+		return buildTCRet(kTCComponentLoadModule, kTCReturnInsufficientLength, 0);
+	}
+
+	const TrustCacheModuleBase_t *base = (const TrustCacheModuleBase_t *)dataAddr;
+	size_t entryOff, entrySize;
+	bool sorted;
+	if (!mini_tc_module_layout(base->version, &entryOff, &entrySize, &sorted)) {
+		return buildTCRet(kTCComponentLoadModule, kTCReturnInvalidModule, 0);
+	}
+
+	/* The entry array must fit inside the module bytes we were handed. */
+	uint32_t n = mini_tc_module_num_entries(base);
+	if (dataSize < entryOff || (dataSize - entryOff) / entrySize < n) {
+		return buildTCRet(kTCComponentLoadModule, kTCReturnInsufficientLength, 0);
+	}
+
+	trustCache->prev = NULL;
+	trustCache->type = type;
+	trustCache->moduleSize = dataSize;
+	trustCache->module = base;
+
+	/* Static and engineering caches are immutable roots; everything else is loadable. */
+	TrustCache_t **head;
+	if (type == kTCTypeStatic) {
+		head = &runtime->staticTCHead;
+	} else if (type == kTCTypeEngineering) {
+		head = &runtime->engineeringTCHead;
+	} else if (runtime->mutableRT != NULL) {
+		head = &runtime->mutableRT->loadableTCHead;
+	} else {
+		return buildTCRet(kTCComponentLoadModule, kTCReturnInvalidArguments, 0);
+	}
+	trustCache->next = *head;
+	if (*head != NULL) {
+		(*head)->prev = trustCache;
+	}
+	*head = trustCache;
+
+	return buildTCRet(kTCComponentLoadModule, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_load(__unused TrustCacheRuntime_t *runtime, __unused TCType_t type, __unused TrustCache_t *trustCache,
+    __unused const uintptr_t payloadAddr, __unused const size_t payloadSize,
+    __unused const uintptr_t manifestAddr, __unused const size_t manifestSize)
+{
+	return buildTCRet(kTCComponentLoad, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_query(const TrustCacheRuntime_t *runtime, TCQueryType_t queryType,
+    const uint8_t CDHash[kTCEntryHashSize], TrustCacheQueryToken_t *queryToken)
+{
+	if (runtime == NULL || CDHash == NULL || queryToken == NULL) {
+		return buildTCRet(kTCComponentQuery, kTCReturnInvalidArguments, 0);
+	}
+
+	/* The lists to walk, in order, for this query type (matching libTrustCache's semantics). */
+	const TrustCache_t *lists[3];
+	uint32_t count = 0;
+	if (queryType == kTCQueryTypeAll || queryType == kTCQueryTypeStatic) {
+		lists[count++] = runtime->staticTCHead;
+		lists[count++] = runtime->engineeringTCHead;
+	}
+	if (queryType == kTCQueryTypeAll || queryType == kTCQueryTypeLoadable) {
+		lists[count++] = runtime->mutableRT ? runtime->mutableRT->loadableTCHead : NULL;
+	}
+	if (count == 0) {
+		return buildTCRet(kTCComponentQuery, kTCReturnInvalidArguments, 0);
+	}
+
+	for (uint32_t i = 0; i < count; i++) {
+		for (const TrustCache_t *tc = lists[i]; tc != NULL; tc = tc->next) {
+			const void *entry = mini_tc_find_in_module(tc->module, CDHash);
+			if (entry != NULL) {
+				queryToken->trustCache = tc;
+				queryToken->trustCacheEntry = entry;
+				return buildTCRet(kTCComponentQuery, kTCReturnSuccess, 0);
+			}
+		}
+	}
+
+	queryToken->trustCache = NULL;
+	queryToken->trustCacheEntry = NULL;
+	return buildTCRet(kTCComponentQuery, kTCReturnNotFound, 0);
+}
+
+static TCReturn_t
+mini_tc_getCapabilities(__unused const TrustCache_t *trustCache, TCCapabilities_t *capabilities)
+{
+	*capabilities = 0;
+	return buildTCRet(kTCComponentModuleCapabilities, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_queryGetTCType(const TrustCacheQueryToken_t *queryToken, TCType_t *typeRet)
+{
+	if (queryToken == NULL || queryToken->trustCache == NULL || typeRet == NULL) {
+		return buildTCRet(kTCComponentQueryTCType, kTCReturnInvalidArguments, 0);
+	}
+	*typeRet = queryToken->trustCache->type;
+	return buildTCRet(kTCComponentQueryTCType, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_queryGetCapabilities(__unused const TrustCacheQueryToken_t *queryToken, __unused TCCapabilities_t *capabilities)
+{
+	return buildTCRet(kTCComponentModuleCapabilities, kTCReturnInvalidArguments, 0);
+}
+
+static TCReturn_t
+mini_tc_queryGetHashType(const TrustCacheQueryToken_t *queryToken, uint8_t *hashTypeRet)
+{
+	if (queryToken == NULL || queryToken->trustCache == NULL ||
+	    queryToken->trustCacheEntry == NULL || hashTypeRet == NULL) {
+		return buildTCRet(kTCComponentQueryHashType, kTCReturnInvalidArguments, 0);
+	}
+	/* hashType follows the 20-byte CDHash in v1/v2 entries; v0 carries none. */
+	if (queryToken->trustCache->module->version == 0) {
+		*hashTypeRet = 0;
+	} else {
+		*hashTypeRet = ((const uint8_t *)queryToken->trustCacheEntry)[kTCEntryHashSize];
+	}
+	return buildTCRet(kTCComponentQueryHashType, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_queryGetFlags(const TrustCacheQueryToken_t *queryToken, uint64_t *flagsRet)
+{
+	if (queryToken == NULL || queryToken->trustCache == NULL ||
+	    queryToken->trustCacheEntry == NULL || flagsRet == NULL) {
+		return buildTCRet(kTCComponentQueryFlags, kTCReturnInvalidArguments, 0);
+	}
+	if (queryToken->trustCache->module->version == 0) {
+		*flagsRet = 0;
+	} else {
+		*flagsRet = ((const uint8_t *)queryToken->trustCacheEntry)[kTCEntryHashSize + 1];
+	}
+	return buildTCRet(kTCComponentQueryFlags, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_queryGetConstraintCategory(const TrustCacheQueryToken_t *queryToken, uint8_t *constraintCategoryRet)
+{
+	if (queryToken == NULL || queryToken->trustCache == NULL ||
+	    queryToken->trustCacheEntry == NULL || constraintCategoryRet == NULL) {
+		return buildTCRet(kTCComponentQueryConstraintCategory, kTCReturnInvalidArguments, 0);
+	}
+	/* Only v2 entries carry a constraint category. */
+	if (queryToken->trustCache->module->version >= 2) {
+		*constraintCategoryRet = ((const uint8_t *)queryToken->trustCacheEntry)[kTCEntryHashSize + 2];
+	} else {
+		*constraintCategoryRet = 0;
+	}
+	return buildTCRet(kTCComponentQueryConstraintCategory, kTCReturnSuccess, 0);
+}
+
+static TCReturn_t
+mini_tc_constructInvalid(__unused TrustCache_t *trustCache, __unused const uint8_t *moduleAddr, __unused size_t moduleSize)
+{
+	return buildTCRet(kTCComponentConstructInvalid, kTCReturnUnsupported, 0);
+}
+
+static TCReturn_t
+mini_tc_checkRuntimeForUUID(__unused const TrustCacheRuntime_t *runtime, __unused const uint8_t checkUUID[kUUIDSize],
+    __unused const TrustCache_t **trustCacheRet)
+{
+	return buildTCRet(kTCComponentCheckRuntimeForUUID, kTCReturnNotFound, 0);
+}
+
+static TCReturn_t
+mini_tc_extractModule(__unused TrustCache_t *trustCache, __unused const uint8_t *dataAddr, __unused size_t dataSize)
+{
+	return buildTCRet(kTCComponentExtractModule, kTCReturnUnsupported, 0);
+}
+
+static TCReturn_t
+mini_tc_getModule(__unused const TrustCache_t *trustCache, __unused const uint8_t **moduleAddrRet, __unused size_t *moduleSizeRet)
+{
+	return buildTCRet(kTCComponentGetModule, kTCReturnUnsupported, 0);
+}
+
+static TCReturn_t
+mini_tc_getUUID(__unused const TrustCache_t *trustCache, __unused uint8_t returnUUID[kUUIDSize])
+{
+	return buildTCRet(kTCComponentGetUUID, kTCReturnUnsupported, 0);
+}
+
+static const amfi_t miniamfi = {
+	.OSEntitlements_invalidate = mini_OSEntitlements_invalidate,
+	.OSEntitlements_asdict = mini_OSEntitlements_asdict,
+	.OSEntitlements_get_transmuted = mini_OSEntitlements_get_transmuted,
+	.OSEntitlements_get_xml = mini_OSEntitlements_get_xml,
+	.get_legacy_profile_exemptions = mini_get_legacy_profile_exemptions,
+	.get_udid = mini_get_udid,
+	.query_context_to_object = mini_query_context_to_object,
+
+	.TrustCache = {
+		.version = TRUST_CACHE_INTERFACE_VERSION,
+		.loadModule = mini_tc_loadModule,
+		.load = mini_tc_load,
+		.query = mini_tc_query,
+		.getCapabilities = mini_tc_getCapabilities,
+		.queryGetTCType = mini_tc_queryGetTCType,
+		.queryGetCapabilities = mini_tc_queryGetCapabilities,
+		.queryGetHashType = mini_tc_queryGetHashType,
+		.queryGetFlags = mini_tc_queryGetFlags,
+		.queryGetConstraintCategory = mini_tc_queryGetConstraintCategory,
+		.constructInvalid = mini_tc_constructInvalid,
+		.checkRuntimeForUUID = mini_tc_checkRuntimeForUUID,
+		.extractModule = mini_tc_extractModule,
+		.getModule = mini_tc_getModule,
+		.getUUID = mini_tc_getUUID,
+	},
+
+	.OSEntitlements = {
+		.version = OSENTITLEMENTS_INTERFACE_VERSION,
+		.adjustContextWithMonitor = mini_adjustContextWithMonitor,
+		.adjustContextWithoutMonitor = mini_adjustContextWithoutMonitor,
+		.queryEntitlementBoolean = mini_queryEntitlementBoolean,
+		.queryEntitlementBooleanWithProc = mini_queryEntitlementBooleanWithProc,
+		.queryEntitlementString = mini_queryEntitlementString,
+		.queryEntitlementStringWithProc = mini_queryEntitlementStringWithProc,
+		.copyEntitlementAsOSObject = mini_copyEntitlementAsOSObject,
+		.copyEntitlementAsOSObjectWithProc = mini_copyEntitlementAsOSObjectWithProc,
+	},
+};
+
+/*
+ * Stand-in for the AppleImage4 kext's img4 interface. AppleImage4 is no longer started, so nothing
+ * registers img4if, yet bsd/kern/kern_trustcache.c panics ("image4 interface not available") if it is
+ * NULL when the trust cache runtime comes up, and reads img4if->i4if_v7.runtime_default (IMG4_RUNTIME_DEFAULT)
+ * to hand to trustCacheInitializeRuntime(). No img4 function pointer is ever called on this board (the only
+ * img4if-> use outside the PPL pmap, which we do not build, is the i4if_version read in load_trust_cache_with_type),
+ * so only a non-NULL table of the right version is needed; runtime_default is left NULL and is never dereferenced
+ * because image4 manifests are never validated here.
+ */
+SECURITY_READ_ONLY_LATE(static const img4_interface_t) miniimg4 = {
+	.i4if_version = IMG4_INTERFACE_VERSION,
+};
+
+__startup_func
+static void
+miniamfi_init(void)
+{
+	if (!fajita_security_standins()) {
+		return;         /* fajita-security-kexts=1: Apple's AMFI/AppleImage4 register instead */
+	}
+	amfi_interface_register(&miniamfi);
+	img4_interface_register(&miniimg4);
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_FIRST, miniamfi_init);
diff --git a/libkern/amfi/miniamfi_entitlements.cpp b/libkern/amfi/miniamfi_entitlements.cpp
new file mode 100644
index 0000000..73a6fd6
--- /dev/null
+++ b/libkern/amfi/miniamfi_entitlements.cpp
@@ -0,0 +1,124 @@
+/*
+ * Ported from HackiOS (github.com/oosexgang/hackios-xnu-kernel), APSL 2.0.
+ * Entitlement queries for the AMFI stand-in (see miniamfi.c).
+ *
+ * The kernel asks AMFI whether a process holds an entitlement: a key in the
+ * property list that is part of the program's code signature. The real kext
+ * answers from its own validated copy. Here the list embedded in the
+ * signature of the running program is read directly; nothing vouches for it,
+ * in keeping with a kernel that checks no signatures at all. A program
+ * without a signature has no entitlements.
+ */
+
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSString.h>
+#include <libkern/c++/OSUnserialize.h>
+#include <kern/cs_blobs.h>
+#include <mach/kern_return.h>
+#include <kern/kalloc.h>
+#include <string.h>
+
+extern "C" {
+struct proc;
+int cs_entitlements_blob_get(struct proc *p, void **out_start, size_t *out_length);
+
+kern_return_t miniamfi_entitlement_boolean(struct proc *proc, const char *name);
+kern_return_t miniamfi_entitlement_string(struct proc *proc, const char *name, const char *value);
+kern_return_t miniamfi_entitlement_object(struct proc *proc, const char *name, void **object);
+}
+
+/* The entitlements of a process as a dictionary, or NULL; the caller releases it. */
+static OSDictionary *
+copy_entitlements(struct proc *proc)
+{
+	void *start = NULL;
+	size_t length = 0, text_length;
+	OSObject *parsed;
+	OSDictionary *dict;
+	char *text;
+
+	if (proc == NULL || cs_entitlements_blob_get(proc, &start, &length) != 0 || start == NULL ||
+	    length <= sizeof(CS_GenericBlob)) {
+		return NULL;
+	}
+	/*
+	 * The blob is a header followed by the text of an XML property list.
+	 * The parser wants that text terminated, which in the blob it is not.
+	 */
+	text_length = length - sizeof(CS_GenericBlob);
+	text = (char *)kalloc_data(text_length + 1, Z_WAITOK);
+	if (text == NULL) {
+		return NULL;
+	}
+	memcpy(text, ((const CS_GenericBlob *)start)->data, text_length);
+	text[text_length] = '\0';
+	parsed = OSUnserializeXML(text, NULL);
+	kfree_data(text, text_length + 1);
+
+	dict = OSDynamicCast(OSDictionary, parsed);
+	if (dict == NULL && parsed != NULL) {
+		parsed->release();
+	}
+	return dict;
+}
+
+kern_return_t
+miniamfi_entitlement_boolean(struct proc *proc, const char *name)
+{
+	OSDictionary *entitlements = copy_entitlements(proc);
+	kern_return_t result = KERN_NOT_FOUND;
+
+	if (entitlements != NULL) {
+		if (entitlements->getObject(name) == kOSBooleanTrue) {
+			result = KERN_SUCCESS;
+		}
+		entitlements->release();
+	}
+	return result;
+}
+
+/* True if the entitlement is that string, or an array that contains it. */
+kern_return_t
+miniamfi_entitlement_string(struct proc *proc, const char *name, const char *value)
+{
+	OSDictionary *entitlements = copy_entitlements(proc);
+	kern_return_t result = KERN_NOT_FOUND;
+
+	if (entitlements != NULL) {
+		OSObject *object = entitlements->getObject(name);
+		OSString *string = OSDynamicCast(OSString, object);
+		OSArray *array = OSDynamicCast(OSArray, object);
+
+		if (string != NULL && string->isEqualTo(value)) {
+			result = KERN_SUCCESS;
+		}
+		for (unsigned int i = 0; array != NULL && i < array->getCount(); i++) {
+			string = OSDynamicCast(OSString, array->getObject(i));
+			if (string != NULL && string->isEqualTo(value)) {
+				result = KERN_SUCCESS;
+			}
+		}
+		entitlements->release();
+	}
+	return result;
+}
+
+/* The value itself, retained, as IOKit wants it. */
+kern_return_t
+miniamfi_entitlement_object(struct proc *proc, const char *name, void **object)
+{
+	OSDictionary *entitlements = copy_entitlements(proc);
+	OSObject *value = NULL;
+
+	if (entitlements != NULL) {
+		value = entitlements->getObject(name);
+		if (value != NULL) {
+			value->retain();
+		}
+		entitlements->release();
+	}
+	*object = value;
+	return value != NULL ? KERN_SUCCESS : KERN_NOT_FOUND;
+}
