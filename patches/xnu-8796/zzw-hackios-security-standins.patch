+/*********************************************************************
+* fajita (OnePlus 6T, xnu-8796): the AppleMobileFileIntegrity IOService stand-in.
+*
+* Apple's AMFI kext stays prelinked but is never started (libkern/c++/OSKext.cpp), so the
+* "AppleMobileFileIntegrity" IOService it would publish never appears. launchd starts
+* /usr/libexec/launchd_cache_loader, which looks that service up, opens a user client (type 0)
+* and calls selector 6 with the program's cdhash as the structure input to ask whether the hash
+* is in a loaded trust cache; it reads only the return code -- kIOReturnSuccess means trusted,
+* kIOReturnNotFound means not in the trust cache -- and panics launchd if the service is absent.
+*
+* This publishes a minimal service of that class with a user client that answers selector 6
+* truthfully, by looking the cdhash up in the kernel's own loaded trust caches through
+* query_trust_cache() (the static system trust cache is held by libkern/amfi/miniamfi.c). It is
+* gated by the same fajita-security-kexts boot-arg: with the Apple kexts started instead, this
+* does not publish and the real AMFI service appears.
+*********************************************************************/
+extern "C" bool fajita_security_standins(void);
+
+/* TrustCacheQueryToken_t: two pointers (TrustCache/Types.h); we only need the return value. */
+struct fajita_tc_query_token {
+	const void *trustCache;
+	const void *trustCacheEntry;
+};
+/* bsd/kern/kern_trustcache.c; kTCQueryTypeAll == 0, KERN_SUCCESS when the cdhash is trusted. */
+extern "C" kern_return_t query_trust_cache(uint8_t query_type,
+    const uint8_t cdhash[20], struct fajita_tc_query_token *query_token);
+
+#define kFajitaAMFICheckTrustCacheSelector  6
+#define kFajitaCDHashLength                 20
+
+class FajitaAMFIUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(FajitaAMFIUserClient);
+
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+class AppleMobileFileIntegrity : public IOService {
+	OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+
+public:
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties, IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(FajitaAMFIUserClient, IOUserClient);
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+
+bool
+FajitaAMFIUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties)
+{
+	return IOUserClient::initWithTask(owningTask, securityID, type, properties);
+}
+
+IOReturn
+FajitaAMFIUserClient::clientClose(void)
+{
+	if (!isInactive()) {
+		terminate();
+	}
+	return kIOReturnSuccess;
+}
+
+IOReturn
+FajitaAMFIUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference)
+{
+	/* Only the trust-cache check is implemented; it is all launchd_cache_loader asks for. */
+	if (selector != kFajitaAMFICheckTrustCacheSelector) {
+		return IOUserClient::externalMethod(selector, args, dispatch, target, reference);
+	}
+	if (args == NULL) {
+		return kIOReturnBadArgument;
+	}
+
+	uint8_t cdhash[kFajitaCDHashLength];
+	if (args->structureInput != NULL && args->structureInputSize >= kFajitaCDHashLength) {
+		/* cdhashes in the trust cache are truncated to 20 bytes; use the leading bytes. */
+		memcpy(cdhash, args->structureInput, kFajitaCDHashLength);
+	} else if (args->structureInputDescriptor != NULL &&
+	    args->structureInputDescriptor->getLength() >= kFajitaCDHashLength) {
+		IOMemoryDescriptor *md = args->structureInputDescriptor;
+		if (md->prepare(kIODirectionOut) != kIOReturnSuccess) {
+			return kIOReturnVMError;
+		}
+		IOByteCount got = md->readBytes(0, cdhash, kFajitaCDHashLength);
+		md->complete();
+		if (got != kFajitaCDHashLength) {
+			return kIOReturnBadArgument;
+		}
+	} else {
+		return kIOReturnBadArgument;
+	}
+
+	struct fajita_tc_query_token token = { NULL, NULL };
+	kern_return_t kr = query_trust_cache(0 /* kTCQueryTypeAll */, cdhash, &token);
+	if (kr == KERN_SUCCESS) {
+		return kIOReturnSuccess;        /* cdhash is trusted */
+	}
+	return kIOReturnNotFound;               /* not in any loaded trust cache */
+}
+
+IOReturn
+AppleMobileFileIntegrity::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	FajitaAMFIUserClient *client = OSTypeAlloc(FajitaAMFIUserClient);
+	if (client == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!client->initWithTask(owningTask, securityID, type, properties)) {
+		client->release();
+		return kIOReturnBadArgument;
+	}
+	if (!client->attach(this)) {
+		client->release();
+		return kIOReturnInternalError;
+	}
+	if (!client->start(this)) {
+		client->detach(this);
+		client->release();
+		return kIOReturnInternalError;
+	}
+	*handler = client;
+	return kIOReturnSuccess;
+}
+
+static void
+fajita_publish_amfi_standin(void)
+{
+	if (!fajita_security_standins()) {
+		return;         /* fajita-security-kexts=1: Apple's AMFI publishes the real service */
+	}
+
+	AppleMobileFileIntegrity *amfi = OSTypeAlloc(AppleMobileFileIntegrity);
+	if (amfi == NULL) {
+		panic("fajita: failed to allocate AppleMobileFileIntegrity stand-in");
+	}
+	if (!amfi->init() || !amfi->attach(gRootNub)) {
+		panic("fajita: failed to attach AppleMobileFileIntegrity stand-in");
+	}
+	/* Publish synchronously so the service is in the registry before user space looks it up. */
+	amfi->registerService(kIOServiceSynchronous);
+	amfi->release();
+}
