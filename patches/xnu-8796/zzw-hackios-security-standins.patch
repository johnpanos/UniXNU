+/*********************************************************************
+* fajita (OnePlus 6T, xnu-8796): the 20H392 AMFI, AppleImage4 and Sandbox kexts stay prelinked so that
+* IOHIDFamily, IOGPUFamily, IOMobileGraphicsFamily and apfs (which list them as libraries) still link,
+* but their code is never started and their IOKit personalities are never sent to the catalogue -- the
+* kernel's own stand-ins (bsd/kern/kern_minimac.c, libkern/amfi/miniamfi.c) are the AMFI and Sandbox, and
+* starting Apple's would re-register the amfi/img4 interfaces and panic ("interface already set"). The
+* one boot-arg fajita-security-kexts=1 turns this off and starts them as on a stock device (the stand-ins
+* then do not register; see miniamfi.c). Keep the bundle list here, in one place.
+*********************************************************************/
+extern "C" bool fajita_security_standins(void);
+
+static bool
+fajita_skip_security_kext(const char * identifier)
+{
+	static const char * const skip[] = {
+		"com.apple.driver.AppleMobileFileIntegrity",
+		"com.apple.security.AppleImage4",
+		"com.apple.security.sandbox",
+	};
+
+	if (identifier == NULL || !fajita_security_standins()) {
+		return false;
+	}
+	for (size_t i = 0; i < sizeof(skip) / sizeof(skip[0]); i++) {
+		if (strcmp(identifier, skip[i]) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
 /*********************************************************************
 *********************************************************************/
 OSReturn
@@ -8206,6 +8237,17 @@ OSKext::start(bool startDependenciesFlag)
 		goto finish;
 	}
 
+	/* fajita: load (so dependents resolve) but never start; the stand-ins are the policy. */
+	if (fajita_skip_security_kext(getIdentifierCString())) {
